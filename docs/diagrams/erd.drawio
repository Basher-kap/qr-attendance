        <mxCell id="n1" value="&lt;b&gt;qr_token&lt;/b&gt; is the value encoded in each student's QR code. The app draws the QR image from it; no image is stored." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;attendance&lt;/b&gt;: one row per check-in or check-out (replaces the four BOOLEAN columns)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;app_users&lt;/b&gt;: allow-list of Google accounts and their roles (admin or clerk)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="500" width="300" height="40" as="geometry" />
        </mxCell>
